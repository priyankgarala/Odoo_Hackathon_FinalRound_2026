generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Business models are intentionally added in subsequent phases.
model ApplicationSetting {
  id        Int      @id @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Role {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  loginId      String?  @unique
  email        String   @unique
  passwordHash String
  isActive     Boolean  @default(true)
  roleId       Int
  role         Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([roleId])
}

enum ContactType {
  CUSTOMER
  VENDOR
  BOTH
}

model Contact {
  id        Int         @id @default(autoincrement())
  name      String
  type      ContactType
  email     String?     @unique
  phone     String?
  address   String?
  profileImage String?  @db.Text
  active    Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([type, active])
  @@index([name])
  purchaseOrders PurchaseOrder[]
  vendorBills VendorBill[]
  salesOrders SalesOrder[]
  invoices    Invoice[]
  journalEntryLines JournalEntryLine[] @relation("JournalLinePartner")
}

enum ProductType {
  GOODS
  SERVICE
  COMBO
}

model Product {
  id          Int         @id @default(autoincrement())
  sku         String      @unique
  name        String
  description String?
  type        ProductType @default(GOODS)
  unitPrice   Decimal     @db.Decimal(14, 2)
  costPrice   Decimal     @default(0) @db.Decimal(14, 2)
  category    String?
  image       String?     @db.Text
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([name])
  @@index([active])
  defaultTaxId Int?
  defaultTax   Tax?        @relation(fields: [defaultTaxId], references: [id], onDelete: SetNull)
  purchaseOrderItems PurchaseOrderItem[]
  vendorBillItems VendorBillItem[]
  salesOrderItems SalesOrderItem[]
  invoiceItems InvoiceItem[]
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  CAPITAL
  REVENUE
  INCOME
  EXPENSE
}

model Account {
  id        Int         @id @default(autoincrement())
  code      String      @unique
  name      String
  type      AccountType
  parentId  Int?
  parent    Account?    @relation("AccountHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children  Account[]   @relation("AccountHierarchy")
  journalEntryLines JournalEntryLine[]
  defaultForJournals Journal[] @relation("JournalDefaultAccount")
  taxSalesAccounts    Tax[] @relation("TaxSalesAccount")
  taxPurchaseAccounts Tax[] @relation("TaxPurchaseAccount")
  active    Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([parentId])
  @@index([type, active])
}

enum JournalType {
  SALES
  PURCHASE
  CASH
  BANK
  GENERAL
}

enum JournalEntryStatus {
  DRAFT
  POSTED
}

model Journal {
  id               Int            @id @default(autoincrement())
  code             String         @unique
  name             String
  type             JournalType    @unique
  defaultAccountId Int?
  defaultAccount   Account?       @relation("JournalDefaultAccount", fields: [defaultAccountId], references: [id], onDelete: SetNull)
  active           Boolean        @default(true)
  entries          JournalEntry[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model JournalEntry {
  id            Int                @id @default(autoincrement())
  entryNumber   String             @unique
  entryDate     DateTime           @db.Date
  journalId     Int
  journal       Journal            @relation(fields: [journalId], references: [id], onDelete: Restrict)
  referenceType String?
  referenceId   String?
  description   String?
  status        JournalEntryStatus @default(DRAFT)
  lines         JournalEntryLine[]
  vendorBill    VendorBill? @relation("VendorBillJournal")
  invoice       Invoice?    @relation("InvoiceJournal")
  payment       Payment?    @relation("PaymentJournal")
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([journalId, entryDate])
  @@index([referenceType, referenceId])
  @@index([status, entryDate])
}

model JournalEntryLine {
  id             Int          @id @default(autoincrement())
  journalEntryId Int
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      Int
  account        Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  partnerId      Int?
  partner        Contact?     @relation("JournalLinePartner", fields: [partnerId], references: [id], onDelete: SetNull)
  debit          Decimal      @default(0) @db.Decimal(14, 2)
  credit         Decimal      @default(0) @db.Decimal(14, 2)
  description    String?
  createdAt      DateTime     @default(now())

  @@index([journalEntryId])
  @@index([accountId])
  @@index([partnerId])
}

enum TaxType {
  GST
  OTHER
}

model Tax {
  id                 Int                  @id @default(autoincrement())
  name               String
  rate               Decimal              @db.Decimal(5, 2)
  type               TaxType              @default(GST)
  salesAccountId     Int
  salesAccount       Account              @relation("TaxSalesAccount", fields: [salesAccountId], references: [id], onDelete: Restrict)
  purchaseAccountId  Int
  purchaseAccount    Account              @relation("TaxPurchaseAccount", fields: [purchaseAccountId], references: [id], onDelete: Restrict)
  isActive           Boolean              @default(true)
  products           Product[]
  salesOrderItems    SalesOrderItem[]
  purchaseOrderItems PurchaseOrderItem[]
  invoiceTaxLines    InvoiceTaxLine[]
  vendorBillTaxLines VendorBillTaxLine[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([type, isActive])
}

enum PurchaseOrderStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

model PurchaseOrder {
  id          Int                 @id @default(autoincrement())
  orderNumber String              @unique
  vendorId    Int
  vendor      Contact             @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  orderDate   DateTime            @default(now()) @db.Date
  status      PurchaseOrderStatus @default(DRAFT)
  notes       String?
  subtotal    Decimal             @default(0) @db.Decimal(14, 2)
  taxTotal    Decimal             @default(0) @db.Decimal(14, 2)
  total       Decimal             @default(0) @db.Decimal(14, 2)
  items       PurchaseOrderItem[]
  vendorBills VendorBill[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([vendorId, status])
  @@index([orderDate])
}

model PurchaseOrderItem {
  id              Int           @id @default(autoincrement())
  purchaseOrderId Int
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       Int
  product         Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  productSku      String
  productName     String
  quantity        Decimal       @db.Decimal(14, 2)
  unitPrice       Decimal       @db.Decimal(14, 2)
  taxRate         Decimal       @default(0) @db.Decimal(5, 2)
  taxId           Int?
  tax             Tax?          @relation(fields: [taxId], references: [id], onDelete: SetNull)
  lineSubtotal    Decimal       @db.Decimal(14, 2)
  taxAmount       Decimal       @db.Decimal(14, 2)
  lineTotal       Decimal       @db.Decimal(14, 2)
  createdAt       DateTime      @default(now())

  @@index([purchaseOrderId])
  @@index([productId])
}

enum VendorBillStatus {
  POSTED
  PAID
  CANCELLED
}
enum PaymentType {
  VENDOR_PAYMENT
  CUSTOMER_PAYMENT
}
model VendorBill {
  id Int @id @default(autoincrement())
  billNumber String @unique
  purchaseOrderId Int
  purchaseOrder PurchaseOrder @relation(fields:[purchaseOrderId],references:[id],onDelete:Restrict)
  vendorId Int
  vendor Contact @relation(fields:[vendorId],references:[id],onDelete:Restrict)
  billDate DateTime @default(now()) @db.Date
  status VendorBillStatus @default(POSTED)
  subtotal Decimal @db.Decimal(14,2)
  taxTotal Decimal @db.Decimal(14,2)
  total Decimal @db.Decimal(14,2)
  paidAmount Decimal @default(0) @db.Decimal(14,2)
  outstanding Decimal @db.Decimal(14,2)
  journalEntryId Int? @unique
  journalEntry JournalEntry? @relation("VendorBillJournal",fields:[journalEntryId],references:[id],onDelete:Restrict)
  items VendorBillItem[]
  payments Payment[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([vendorId,status])
  @@index([purchaseOrderId])
}
model VendorBillItem {
  id Int @id @default(autoincrement())
  vendorBillId Int
  vendorBill VendorBill @relation(fields:[vendorBillId],references:[id],onDelete:Cascade)
  productId Int
  product Product @relation(fields:[productId],references:[id],onDelete:Restrict)
  productSku String
  productName String
  quantity Decimal @db.Decimal(14,2)
  unitPrice Decimal @db.Decimal(14,2)
  taxRate Decimal @db.Decimal(5,2)
  lineSubtotal Decimal @db.Decimal(14,2)
  taxAmount Decimal @db.Decimal(14,2)
  lineTotal Decimal @db.Decimal(14,2)
  taxLines VendorBillTaxLine[]
  createdAt DateTime @default(now())
  @@index([vendorBillId])
}

model VendorBillTaxLine {
  id               Int            @id @default(autoincrement())
  vendorBillItemId Int
  vendorBillItem   VendorBillItem @relation(fields: [vendorBillItemId], references: [id], onDelete: Cascade)
  taxId            Int?
  tax              Tax?           @relation(fields: [taxId], references: [id], onDelete: SetNull)
  taxName          String
  taxType          String
  rate             Decimal        @db.Decimal(5, 2)
  taxableAmount    Decimal        @db.Decimal(14, 2)
  taxAmount        Decimal        @db.Decimal(14, 2)
  jurisdiction     String?
  createdAt        DateTime       @default(now())

  @@index([vendorBillItemId])
}

model Payment {
  id Int @id @default(autoincrement())
  paymentNumber String @unique
  type PaymentType
  vendorBillId Int?
  vendorBill VendorBill? @relation(fields:[vendorBillId],references:[id],onDelete:Restrict)
  invoiceId Int?
  invoice Invoice? @relation(fields:[invoiceId],references:[id],onDelete:Restrict)
  amount Decimal @db.Decimal(14,2)
  paymentMethod String
  reference String?
  paymentDate DateTime @default(now()) @db.Date
  journalEntryId Int @unique
  journalEntry JournalEntry @relation("PaymentJournal",fields:[journalEntryId],references:[id],onDelete:Restrict)
  createdAt DateTime @default(now())
  @@index([vendorBillId])
  @@index([invoiceId])
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}
model SalesOrder {
  id Int @id @default(autoincrement())
  orderNumber String @unique
  customerId Int
  customer Contact @relation(fields:[customerId],references:[id],onDelete:Restrict)
  orderDate DateTime @default(now()) @db.Date
  status SalesOrderStatus @default(DRAFT)
  notes String?
  subtotal Decimal @default(0) @db.Decimal(14,2)
  taxTotal Decimal @default(0) @db.Decimal(14,2)
  total Decimal @default(0) @db.Decimal(14,2)
  items SalesOrderItem[]
  invoice Invoice?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([customerId,status])
}
model SalesOrderItem {
  id Int @id @default(autoincrement())
  salesOrderId Int
  salesOrder SalesOrder @relation(fields:[salesOrderId],references:[id],onDelete:Cascade)
  productId Int
  product Product @relation(fields:[productId],references:[id],onDelete:Restrict)
  productSku String
  productName String
  quantity Decimal @db.Decimal(14,2)
  unitPrice Decimal @db.Decimal(14,2)
  taxRate Decimal @default(0) @db.Decimal(5,2)
  taxId Int?
  tax   Tax? @relation(fields: [taxId], references: [id], onDelete: SetNull)
  lineSubtotal Decimal @db.Decimal(14,2)
  taxAmount Decimal @db.Decimal(14,2)
  lineTotal Decimal @db.Decimal(14,2)
  createdAt DateTime @default(now())
  @@index([salesOrderId])
  @@index([productId])
}

enum InvoiceStatus {
  POSTED
  PAID
  CANCELLED
}

model Invoice {
  id Int @id @default(autoincrement())
  invoiceNumber String @unique
  salesOrderId Int @unique
  salesOrder SalesOrder @relation(fields:[salesOrderId],references:[id],onDelete:Restrict)
  customerId Int
  customer Contact @relation(fields:[customerId],references:[id],onDelete:Restrict)
  invoiceDate DateTime @default(now()) @db.Date
  dueDate DateTime @db.Date
  status InvoiceStatus @default(POSTED)
  subtotal Decimal @db.Decimal(14,2)
  taxTotal Decimal @db.Decimal(14,2)
  total Decimal @db.Decimal(14,2)
  paidAmount Decimal @default(0) @db.Decimal(14,2)
  outstanding Decimal @db.Decimal(14,2)
  journalEntryId Int? @unique
  journalEntry JournalEntry? @relation("InvoiceJournal",fields:[journalEntryId],references:[id],onDelete:Restrict)
  items InvoiceItem[]
  payments Payment[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([customerId,status])
  @@index([invoiceDate])
}

model InvoiceItem {
  id Int @id @default(autoincrement())
  invoiceId Int
  invoice Invoice @relation(fields:[invoiceId],references:[id],onDelete:Cascade)
  productId Int
  product Product @relation(fields:[productId],references:[id],onDelete:Restrict)
  productSku String
  productName String
  quantity Decimal @db.Decimal(14,2)
  unitPrice Decimal @db.Decimal(14,2)
  taxRate Decimal @db.Decimal(5,2)
  lineSubtotal Decimal @db.Decimal(14,2)
  taxAmount Decimal @db.Decimal(14,2)
  lineTotal Decimal @db.Decimal(14,2)
  taxLines InvoiceTaxLine[]
  createdAt DateTime @default(now())
  @@index([invoiceId])
}

model InvoiceTaxLine {
  id            Int         @id @default(autoincrement())
  invoiceItemId Int
  invoiceItem   InvoiceItem @relation(fields: [invoiceItemId], references: [id], onDelete: Cascade)
  taxId         Int?
  tax           Tax?        @relation(fields: [taxId], references: [id], onDelete: SetNull)
  taxName       String
  taxType       String
  rate          Decimal     @db.Decimal(5, 2)
  taxableAmount Decimal     @db.Decimal(14, 2)
  taxAmount     Decimal     @db.Decimal(14, 2)
  jurisdiction  String?
  createdAt     DateTime    @default(now())

  @@index([invoiceItemId])
}

enum AnalyticType {
  INCOME
  EXPENSE
}

model AnalyticAccount {
  id        Int          @id @default(autoincrement())
  name      String
  type      AnalyticType
  active    Boolean      @default(true)
  budgets   Budget[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([type, active])
}

model Budget {
  id                Int             @id @default(autoincrement())
  name              String
  period            String
  plannedAmount     Decimal         @db.Decimal(14, 2)
  responsiblePerson String
  analyticAccountId Int
  analyticAccount   AnalyticAccount @relation(fields: [analyticAccountId], references: [id], onDelete: Restrict)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([analyticAccountId])
}
